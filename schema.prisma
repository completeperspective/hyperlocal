model Hero {
  id                        String      @id @default(cuid())
  name                      String      @default("")
  heroEyebrow               String      @default("")
  heroTitle                 String      @default("")
  heroTitleHighlight        String      @default("")
  heroDescription           String      @default("")
  heroCtaLabel              String      @default("")
  heroCtaHref               String      @default("")
  heroSecondaryLabel        String      @default("")
  heroSecondaryHref         String      @default("")
  heroStat1Value            String      @default("")
  heroStat1Label            String      @default("")
  heroStat2Value            String      @default("")
  heroStat2Label            String      @default("")
  heroStat3Value            String      @default("")
  heroStat3Label            String      @default("")
  heroImage                 String      @default("")
  heroImageBadgeTitle       String      @default("")
  heroImageBadgeSubtitle    String      @default("")
  heroBackgroundImage       String      @default("")
  heroBackgroundImageMobile String      @default("")
  heroFullscreen            Boolean     @default(false)
  heroHideGrid              Boolean     @default(false)
  from_Page_hero            Page[]      @relation("Page_hero")
  from_Course_hero          Course[]    @relation("Course_hero")
  from_PageIndex_hero       PageIndex[] @relation("PageIndex_hero")
}

model Page {
  id                             String                 @id @default(cuid())
  title                          String                 @default("")
  description                    String                 @default("")
  metaTitle                      String                 @default("")
  metaDescription                String                 @default("")
  ogImage                        OGImage?               @relation("Page_ogImage", fields: [ogImageId], references: [id])
  ogImageId                      String?                @map("ogImage")
  slug                           String                 @unique @default("")
  publishedAt                    DateTime?
  status                         String?                @default("draft")
  content                        Json                   @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  trustedHtml                    String                 @default("")
  customCss                      String                 @default("")
  heroEnabled                    Boolean                @default(false)
  hero                           Hero?                  @relation("Page_hero", fields: [heroId], references: [id])
  heroId                         String?                @map("hero")
  theme                          Theme?                 @relation("Page_theme", fields: [themeId], references: [id])
  themeId                        String?                @map("theme")
  attachments                    PageAttachment[]       @relation("PageAttachment_page")
  from_Course_pages              Course[]               @relation("Course_pages")
  from_Chapter_pages             Chapter[]              @relation("Chapter_pages")
  from_CourseLessonProgress_page CourseLessonProgress[] @relation("CourseLessonProgress_page")
  from_PageIndex_pages           PageIndex[]            @relation("PageIndex_pages")
  from_PageGroup_pages           PageGroup[]            @relation("PageGroup_pages")

  @@index([ogImageId])
  @@index([heroId])
  @@index([themeId])
}

model PageAttachment {
  id               String  @id @default(cuid())
  page             Page?   @relation("PageAttachment_page", fields: [pageId], references: [id])
  pageId           String? @map("page")
  title            String  @default("")
  cloudinaryUpload Json?
  filename         String  @default("")
  publicId         String  @default("")
  publicUrl        String  @default("")
  mimeType         String  @default("")
  format           String  @default("")
  bytes            Int?

  @@index([pageId])
}

model Profile {
  id                String        @id @default(cuid())
  owner             User?         @relation("Profile_owner", fields: [ownerId], references: [id])
  ownerId           String?       @unique @map("owner")
  nickname          String        @default("")
  description       String        @default("")
  location          String        @default("Earth")
  isPublic          Boolean       @default(false)
  image             ProfileImage? @relation("Profile_image", fields: [imageId], references: [id])
  imageId           String?       @unique @map("image")
  contactPreference String?       @default("email")
}

model ProfileImage {
  id      String   @id @default(cuid())
  profile Profile? @relation("Profile_image")
  title   String   @default("")
  source  Json?
  altText String   @default("")
}

model OGImage {
  id                     String      @id @default(cuid())
  title                  String      @default("")
  source                 Json?
  altText                String      @default("")
  from_Settings_ogImage  Settings[]  @relation("Settings_ogImage")
  from_Page_ogImage      Page[]      @relation("Page_ogImage")
  from_Course_ogImage    Course[]    @relation("Course_ogImage")
  from_PageIndex_ogImage PageIndex[] @relation("PageIndex_ogImage")
}

model MembershipTier {
  id                    String           @id @default(cuid())
  name                  String           @default("")
  description           String           @default("")
  priceInCents          Int?             @default(0)
  currency              String?          @default("usd")
  paymentType           String?          @default("free")
  recurringInterval     String?
  stripeProductId       String?
  stripePriceId         String?
  isActive              Boolean          @default(true)
  contentAccessPatterns Json?
  members               UserMembership[] @relation("UserMembership_tier")
}

model UserMembership {
  id                      String          @id @default(cuid())
  user                    User?           @relation("UserMembership_user", fields: [userId], references: [id])
  userId                  String?         @map("user")
  tier                    MembershipTier? @relation("UserMembership_tier", fields: [tierId], references: [id])
  tierId                  String?         @map("tier")
  status                  String?         @default("pending")
  stripeCheckoutSessionId String?
  stripeSubscriptionId    String?
  cryptoTxHash            String?
  paymentMethod           String?
  activatedAt             DateTime?
  expiresAt               DateTime?

  @@index([userId])
  @@index([tierId])
}

model Course {
  id                       String                 @id @default(cuid())
  title                    String                 @default("")
  description              String                 @default("")
  slug                     String                 @unique @default("")
  publishedAt              DateTime?
  status                   String?                @default("draft")
  metaTitle                String                 @default("")
  metaDescription          String                 @default("")
  ogImage                  OGImage?               @relation("Course_ogImage", fields: [ogImageId], references: [id])
  ogImageId                String?                @map("ogImage")
  content                  Json                   @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  trustedHtml              String                 @default("")
  customCss                String                 @default("")
  heroEnabled              Boolean                @default(false)
  hero                     Hero?                  @relation("Course_hero", fields: [heroId], references: [id])
  heroId                   String?                @map("hero")
  theme                    Theme?                 @relation("Course_theme", fields: [themeId], references: [id])
  themeId                  String?                @map("theme")
  pages                    Page[]                 @relation("Course_pages")
  chapters                 Chapter[]              @relation("Chapter_course")
  enrollments              CourseEnrollment[]     @relation("CourseEnrollment_course")
  lessonProgress           CourseLessonProgress[] @relation("CourseLessonProgress_course")
  from_Settings_rootCourse Settings[]             @relation("Settings_rootCourse")

  @@index([ogImageId])
  @@index([heroId])
  @@index([themeId])
}

model Chapter {
  id        String  @id @default(cuid())
  title     String  @default("")
  sortOrder Int?    @default(0)
  course    Course? @relation("Chapter_course", fields: [courseId], references: [id])
  courseId  String? @map("course")
  pages     Page[]  @relation("Chapter_pages")

  @@index([courseId])
}

model LearnerProfile {
  id                    String                 @id @default(cuid())
  user                  User?                  @relation("LearnerProfile_user", fields: [userId], references: [id])
  userId                String?                @unique @map("user")
  totalLessonsCompleted Int?                   @default(0)
  totalCoursesCompleted Int?                   @default(0)
  lastActiveAt          DateTime?
  learningPreferences   Json?                  @default("{}")
  enrollments           CourseEnrollment[]     @relation("CourseEnrollment_learnerProfile")
  lessonProgress        CourseLessonProgress[] @relation("CourseLessonProgress_learnerProfile")
}

model CourseEnrollment {
  id               String          @id @default(cuid())
  user             User?           @relation("CourseEnrollment_user", fields: [userId], references: [id])
  userId           String?         @map("user")
  learnerProfile   LearnerProfile? @relation("CourseEnrollment_learnerProfile", fields: [learnerProfileId], references: [id])
  learnerProfileId String?         @map("learnerProfile")
  course           Course?         @relation("CourseEnrollment_course", fields: [courseId], references: [id])
  courseId         String?         @map("course")
  enrolledAt       DateTime        @default(now())
  lastAccessedAt   DateTime?
  status           String?         @default("enrolled")
  completedAt      DateTime?

  @@index([userId])
  @@index([learnerProfileId])
  @@index([courseId])
}

model CourseLessonProgress {
  id               String          @id @default(cuid())
  user             User?           @relation("CourseLessonProgress_user", fields: [userId], references: [id])
  userId           String?         @map("user")
  learnerProfile   LearnerProfile? @relation("CourseLessonProgress_learnerProfile", fields: [learnerProfileId], references: [id])
  learnerProfileId String?         @map("learnerProfile")
  course           Course?         @relation("CourseLessonProgress_course", fields: [courseId], references: [id])
  courseId         String?         @map("course")
  page             Page?           @relation("CourseLessonProgress_page", fields: [pageId], references: [id])
  pageId           String?         @map("page")
  viewCount        Int?            @default(0)
  firstViewedAt    DateTime?
  lastViewedAt     DateTime?
  completedAt      DateTime?

  @@index([userId])
  @@index([learnerProfileId])
  @@index([courseId])
  @@index([pageId])
}

model PageIndex {
  id                          String      @id @default(cuid())
  title                       String      @default("")
  slug                        String      @unique @default("")
  basePath                    String      @default("")
  publishedAt                 DateTime?
  status                      String?     @default("draft")
  metaTitle                   String      @default("")
  metaDescription             String      @default("")
  ogImage                     OGImage?    @relation("PageIndex_ogImage", fields: [ogImageId], references: [id])
  ogImageId                   String?     @map("ogImage")
  groupsLabel                 String      @default("Groups")
  content                     Json        @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  trustedHtml                 String      @default("")
  customCss                   String      @default("")
  heroEnabled                 Boolean     @default(false)
  hero                        Hero?       @relation("PageIndex_hero", fields: [heroId], references: [id])
  heroId                      String?     @map("hero")
  theme                       Theme?      @relation("PageIndex_theme", fields: [themeId], references: [id])
  themeId                     String?     @map("theme")
  pages                       Page[]      @relation("PageIndex_pages")
  groups                      PageGroup[] @relation("PageGroup_pageIndex")
  from_Settings_rootPageIndex Settings[]  @relation("Settings_rootPageIndex")

  @@index([ogImageId])
  @@index([heroId])
  @@index([themeId])
}

model PageGroup {
  id          String     @id @default(cuid())
  title       String     @default("")
  sortOrder   Int?       @default(0)
  pageIndex   PageIndex? @relation("PageGroup_pageIndex", fields: [pageIndexId], references: [id])
  pageIndexId String?    @map("pageIndex")
  pages       Page[]     @relation("PageGroup_pages")

  @@index([pageIndexId])
}
