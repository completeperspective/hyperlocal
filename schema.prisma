// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource postgresql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                             String                 @id @default(cuid())
  name                           String                 @default("")
  email                          String                 @unique @default("")
  recoveryPhrase                 String?
  isAdmin                        Boolean                @default(false)
  profile                        Profile?               @relation("Profile_owner")
  walletAddress                  String?                @unique
  mobile                         String?                @unique
  learnerProfile                 LearnerProfile?        @relation("LearnerProfile_user")
  from_UserMembership_user       UserMembership[]       @relation("UserMembership_user")
  from_CourseEnrollment_user     CourseEnrollment[]     @relation("CourseEnrollment_user")
  from_CourseLessonProgress_user CourseLessonProgress[] @relation("CourseLessonProgress_user")
}

model Settings {
  id                    Int        @id
  siteName              String     @default("")
  baseUrl               String     @default("")
  copyright             String     @default("")
  metaTitle             String     @default("")
  metaDescription       String     @default("")
  ogImage               OGImage?   @relation("Settings_ogImage", fields: [ogImageId], references: [id])
  ogImageId             String?    @map("ogImage")
  robots                String?    @default("noindex, nofollow, noarchive, nosnippet")
  isPrivate             Boolean    @default(true)
  allowSignup           Boolean    @default(false)
  maintenanceMode       Boolean    @default(false)
  maintenanceMessage    String     @default("We'll be back shortly.")
  gaTrackingId          String     @default("")
  socialLinks           Json?
  theme                 Theme?     @relation("Settings_theme", fields: [themeId], references: [id])
  themeId               String?    @map("theme")
  rootPageIndex         PageIndex? @relation("Settings_rootPageIndex", fields: [rootPageIndexId], references: [id])
  rootPageIndexId       String?    @map("rootPageIndex")
  rootCourse            Course?    @relation("Settings_rootCourse", fields: [rootCourseId], references: [id])
  rootCourseId          String?    @map("rootCourse")
  transparentHeader     Boolean    @default(true)
  allowWeb3Auth         Boolean    @default(true)
  web3SignInMessage     String     @default("Sign in with your wallet")
  receiverWalletAddress String?

  @@index([ogImageId])
  @@index([themeId])
  @@index([rootPageIndexId])
  @@index([rootCourseId])
}

