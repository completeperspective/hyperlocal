PORT=3333
DATABASE_URL='postgres://localhost:5432/webapp_dev'

AUTH_SESSION_NAME=web-app
AUTH_SESSION_SECRET=ohshowmethewaytothenextwhiskeybar # openssl rand -base64 32
AUTH_SESSION_EXPIRES=86400 # 1 day

CLOUDINARY_CLOUD='cloudinary_cloud_name'
CLOUDINARY_APIKEY='cloudinary_api_key'
CLOUDINARY_SECRET='cloudinary_api_secret'
CLOUDINARY_PROJECT='cloudinary_project_name'

# Reown / WalletConnect Cloud project ID
# Reason: intentionally no NEXT_PUBLIC_ prefix — these are read server-side at
# runtime via /api/v1/config/client and injected into the client after page load.
# This keeps the Docker image config-agnostic (build once, deploy to any env).
WALLETCONNECT_PROJECT_ID='your_project_id_here'

# Optional: Alchemy RPC keys for better reliability
ALCHEMY_BASE_KEY=your_base_mainnet_key
ALCHEMY_BASE_SEPOLIA_KEY=your_base_sepolia_key

# Flip to true to use Base Sepolia testnet instead of Base mainnet
ENABLE_TESTNETS=false

# Stripe (required for paid memberships)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Required for signed crypto payment quotes (prevents quote tampering)
# Generate with: openssl rand -base64 32
CRYPTO_QUOTE_HMAC_SECRET=your_32_plus_char_secret_here
