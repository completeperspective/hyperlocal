{
  "name": "hyperlocal",
  "description": "An open source community engagement platform.",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "build": "pnpm keystone:build && pnpm next:build",
    "clean": "./scripts/clean.sh",
    "dev": "concurrently -k -p \"[{name}]\" -n \"data,web\" -c \"green,blue\" \"pnpm keystone:dev\" \"pnpm next:dev\"",
    "db:seed": "tsx ./seed-data/index.ts",
    "db:seed:courses": "tsx ./seed-data/seed-courses.ts",
    "course:dist": "tsx ./seed-data/build-dist.ts",
    "course:publish": "tsx ./seed-data/publish-course.ts",
    "db:clone": "./scripts/db-clone.sh",
    "db:generate": "keystone prisma generate",
    "db:studio": "keystone prisma studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "keystone:build": "keystone build --no-ui",
    "keystone:dev": "keystone dev",
    "keystone:init": "keystone build --no-ui && pnpm db:generate",
    "lint": "eslint",
    "next:dev": "next dev -p 7777",
    "next:build": "NODE_ENV=production next build",
    "next:start": "NODE_ENV=production next start",
    "postinstall": "pnpm keystone:init",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit --incremental false",
    "validate": "pnpm lint && pnpm format:check && pnpm type-check && pnpm test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@keystone-6/auth": "^8.1.0",
    "@keystone-6/cloudinary": "^8.0.0",
    "@keystone-6/core": "^6.5.0",
    "@keystone-6/document-renderer": "^1.1.2",
    "@keystone-6/fields-document": "^9.1.1",
    "@prisma/client": "^5.22.0",
    "@reown/appkit": "^1.8.19",
    "@reown/appkit-adapter-wagmi": "^1.8.19",
    "@stripe/stripe-js": "^9.4.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.100.7",
    "@wagmi/core": "^3.4.8",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "dotenv": "^16.5.0",
    "graphql": "^16.13.2",
    "graphql-upload": "^15.0.2",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.14.0",
    "micromatch": "^4.0.8",
    "mime-types": "^3.0.2",
    "next": "15.1.12",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.99.0",
    "stripe": "^22.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "viem": "^2.48.7",
    "wagmi": "^3.6.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/culori": "^4.0.1",
    "@types/graphql-upload": "^15.0.2",
    "@types/micromatch": "^4.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.12",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "marked": "^18.0.3",
    "msw": "^2.14.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "5.22.0",
    "slate": "0.123.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "^22"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --quiet --fix"
    ],
    "*.{js,jsx,ts,tsx,json,css,scss,md,mjs,html}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
